--- sokohai_orig/css/31-product-actions.css	1970-01-01 00:00:00.000000000 +0000
+++ sokohai/css/31-product-actions.css	2026-09-21 01:33:57.169394375 +0000
@@ -0,0 +1,38 @@
+/* ==========================================================================
+   31-product-actions.css — [FIX 2026-09-20 VITUFE VYA KADI HAVIONEKANI]
+   TATIZO: kifimbo cha vitendo (Chat / Weka Kikapuni / Lipa Sasa / Pendekeza Bei /
+   Omba Usafiri / Agiza Huduma / Weka Dau) kiliwekwa "in-flow" MWISHONI mwa
+   .pm-scroll — baada ya maelezo, usambazaji na tathmini zote. Kwenye kadi yenye
+   maudhui marefu mtumiaji hafiki kukiona, akadhani vitufe havipo.
+
+   SULUHISHO: kifimbo kinakuwa sticky chini ya karatasi ya kadi — kinaonekana
+   MUDA WOTE kadi inapofunguka. Mpangilio unabaki: DETAILS → ACTION → RECOMMENDED.
+   (sticky bottom: kinapofikia nafasi yake ya asili, kinatulia hapo — hakifuniki
+   recommendations zinazofuata chini yake.)
+   ========================================================================== */
+#productModal .pm-scroll > .pm-bar {
+    position: sticky;
+    bottom: 0;
+    z-index: 30;
+    background: #fff;
+    border-top: 1px solid #e2e8f0;
+    border-bottom: none;
+    box-shadow: 0 -6px 18px rgba(15, 23, 42, .10);
+}
+
+/* Hali ya kupakia / hitilafu kabla vitufe havijaja */
+#pmActionArea .pm-bar-loading {
+    flex: 1 1 auto;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 10px;
+    flex-wrap: wrap;
+    min-height: 46px;
+    padding: 6px 10px;
+    color: #64748b;
+    font-size: 13px;
+    font-weight: 700;
+    text-align: center;
+}
+#pmActionArea .pm-bar-loading .pm-bar-btn { flex: 0 0 auto; padding: 0 16px; }
