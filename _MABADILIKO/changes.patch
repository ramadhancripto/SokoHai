+        caches.keys().then(function (keys) {
+          keys.forEach(function (k) { try { caches.delete(k); } catch (e) {} });
+        }).catch(function () {});
+      }
+    } catch (e) {}
+    try { console.log('[SokoHai] dev/preview host — service worker imezimwa, cache imesafishwa'); } catch (e) {}
+    return;
