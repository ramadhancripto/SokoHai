+        empty: ['#F8FBFA', '#D5E2DE', '#18352D'],
+        error: ['#FFF5F5', '#F2D7D5', '#8A2C27'],
+        loading: ['#F8FBFA', '#D5E2DE', '#526962'],
+        warn: ['#FFF8E6', '#F0DFAE', '#5C4A12']
